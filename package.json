{
  "name": "relaypulse",
  "version": "1.0.0",
  "description": "AI Outbound Sales & Speed-to-Lead Orchestration Engine",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node --eval \"import('fs').then(fs => fs.cpSync('src/public', 'dist/public', { recursive: true, force: true }))\"",
    "start": "node dist/index.js",
    "seed": "tsx src/seeds/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
